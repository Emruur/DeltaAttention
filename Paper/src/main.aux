\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Delta-based tile scoring. Delta pre-processing selects content-adaptive anchors (blue) from $Q$ and $K$ independently, producing $Q^\delta $ and $K^\delta $. Their product gives an $(\alpha B)\times (\beta B)$ score matrix; each entry (highlighted cell, arrow) corresponds to a single dot product at one position in the full $B\times B$ score tile.}}{19}{figure.caption.16}\protected@file@percent }
\newlabel{fig:delta_tile_scoring}{{11}{19}{Delta-based tile scoring. Delta pre-processing selects content-adaptive anchors (blue) from $Q$ and $K$ independently, producing $Q^\delta $ and $K^\delta $. Their product gives an $(\alpha B)\times (\beta B)$ score matrix; each entry (highlighted cell, arrow) corresponds to a single dot product at one position in the full $B\times B$ score tile}{figure.caption.16}{}}
