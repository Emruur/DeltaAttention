\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces The three stages of Delta-KV compression. Stage 1 (pre-processing) computes row-wise deltas of $K$ and thresholds them into a keep mask. Stage 2 (packing) drops the masked rows to form $\hat  {K}$ and $\hat  {V}$ of length $m < n$. Stage 3 (self-attention) multiplies $Q$ against $\hat  {K}$, applies softmax, and multiplies by $\hat  {V}$ to give the $n \times l$ output.}}{15}{figure.caption.15}\protected@file@percent }
\newlabel{fig:delta_attention}{{10}{15}{The three stages of Delta-KV compression. Stage 1 (pre-processing) computes row-wise deltas of $K$ and thresholds them into a keep mask. Stage 2 (packing) drops the masked rows to form $\hat {K}$ and $\hat {V}$ of length $m < n$. Stage 3 (self-attention) multiplies $Q$ against $\hat {K}$, applies softmax, and multiplies by $\hat {V}$ to give the $n \times l$ output}{figure.caption.15}{}}
