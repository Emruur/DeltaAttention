\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Delta-based tile scoring. Delta pre-processing selects content-adaptive anchors (blue) from $Q$ and $K$ independently, producing $\hat  {Q}$ and $\hat  {K}$. Their product gives an $(\alpha B)\times (\beta B)$ score matrix; each entry (highlighted cell, arrow) corresponds to a single dot product at one position in the full $B\times B$ score tile.}}{3}{figure.caption.4}\protected@file@percent }
\newlabel{fig:delta_tile_scoring}{{3}{3}{Delta-based tile scoring. Delta pre-processing selects content-adaptive anchors (blue) from $Q$ and $K$ independently, producing $\hat {Q}$ and $\hat {K}$. Their product gives an $(\alpha B)\times (\beta B)$ score matrix; each entry (highlighted cell, arrow) corresponds to a single dot product at one position in the full $B\times B$ score tile}{figure.caption.4}{}}
